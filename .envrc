# Load devenv shell environment (provides PATH, env vars, tools, etc.)
# Inherited by opencode and all its background/subagent sessions.
use devenv

# Orchestrator Environment Variables
export LLAMA_BASEURL=http://localhost:8080/v1
export OPENCODE_MODEL=qwen3.6-35b-a3b
export ORCHESTRATOR_LOG_DIR=graphos-out/orchestrator
export ORCHESTRATOR_MAX_REMEDIATION=3
export ORCHESTRATOR_TIMEOUT=3600
