/-
  Graphos formalization — AVI-618 §6: the Lean arm of the modularity cross-check.

  Requirements:
  `docs/math-requirements/AVI-618-auditable-modularity-lean-formalization-requirements.md`
  §5 (pinned fixtures) and §6 (the `|Q_lean − Q_hs| ≤ eps` contract).

  ## What this executable does

  It evaluates `EdgeGraph.modularityNum` — the very function the Phase 1
  theorems are stated about — on the seven pinned §5 fixtures
  (`Phase1/CrossCheckFixtures.lean`) and prints, per fixture, the exact
  numerator `qnum = (2m)²·Q`, the reduced rational `Q = num/den`, and a
  decimal rendering.

  Because the Lean side is exact (`ℚ`) and the Haskell side (`modularity`) is
  `Double`, the contract's tolerance absorbs rounding only:

  ```
    | Q_lean(f) − Q_hs(f) | ≤ 2⁻²⁴
  ```

  `--tsv` writes the machine-readable table that the Haskell arm
  (`tests/Graphos/Domain/ModularityCrossCheckSpec.hs`) reads from
  `crosscheck/q-lean.tsv`; the default mode prints a human-readable table.

  `--check <file>` regenerates the table and diffs it against `<file>`, so CI
  detects Lean-side drift (`lean.yml` runs it report-only). Regenerate with:

  ```
    lake exe modularity-crosscheck --tsv > crosscheck/q-lean.tsv
  ```

  ## Why the values can be computed at all

  `modularityNum` is `Nat`/`Int` arithmetic (`RangeBound.lean`), so kernel
  evaluation reduces the concrete fixtures to literals. The `Float` rendering
  of `modularity` is **not** evaluable in dependency-free core Lean
  (`Float.add`/`Float.div` are `opaque @[extern]`), which is exactly why §6
  pins the Lean side to exact rationals and leaves the `Double` rendering to
  the Haskell arm. This executable therefore never touches `Float`.
-/
import GraphosFormalization.Phase1.CrossCheckFixtures

namespace GraphosFormalization

open EdgeGraph

/-- Number of decimal places printed for `Q`. `15` keeps the rendering well
inside the contract's `2⁻²⁴ ≈ 5.96e-8` tolerance; the comparison itself always
uses the exact `num/den` pair, never this string. -/
def qDecimals : Nat := 15

/-- The reduced exact rational `Q = num/den` of a row, over `den = (2m)²`. -/
def CrossCheckRow.reducedQ (r : CrossCheckRow) : Int × Nat :=
  let twoM := 2 * r.m
  let den := twoM * twoM
  let g := Nat.gcd r.qnum.natAbs den
  if g = 0 then (0, 1) else (r.qnum / (g : Int), den / g)

/-- Truncated decimal rendering of `num/den` with `digits` fractional digits. -/
def renderDecimal (num : Int) (den : Nat) (digits : Nat) : String :=
  if den = 0 then "n/a"
  else
    let scale := 10 ^ digits
    let scaled : Nat := num.natAbs * scale / den
    let ip := scaled / scale
    let fp := scaled % scale
    let fpStr := toString fp
    let pad := String.mk (List.replicate (digits - fpStr.length) '0')
    (if num < 0 then "-" else "") ++ toString ip ++ "." ++ pad ++ fpStr

/-- `Q` as a decimal string (`15` places), from the reduced rational. -/
def CrossCheckRow.qDecimal (r : CrossCheckRow) : String :=
  let p := r.reducedQ
  renderDecimal p.1 p.2 qDecimals

/-- `Q` as an exact reduced fraction, e.g. `-1/3` or `11/26`. -/
def CrossCheckRow.qFraction (r : CrossCheckRow) : String :=
  let p := r.reducedQ
  if p.2 = 1 then toString p.1 else s!"{p.1}/{p.2}"

/-- One TSV data line: `fixture  partition  m  qnum  num  den  qdec`. -/
def CrossCheckRow.tsvLine (r : CrossCheckRow) : String :=
  let p := r.reducedQ
  s!"{r.fixture}\t{r.partition}\t{r.m}\t{r.qnum}\t{p.1}\t{p.2}\t{r.qDecimal}"

/-- Header lines (they start with `#` and are skipped by `--check`). -/
def tsvHeader : List String :=
  [ "# Graphos AVI-618 §6 — Lean arm of the modularity cross-check (§5 fixtures)."
  , "# Generated by `lake exe modularity-crosscheck --tsv`; do not edit by hand."
  , "# Lean side is exact: Q = qnum/(2m)^2 = num/den (reduced). Compare with"
  , "# Haskell `modularity` at |Q_lean - Q_hs| <= 2^-24."
  , "# Schema: fixture<TAB>partition<TAB>m<TAB>qnum<TAB>num<TAB>den<TAB>qdec15"
  ]

/-- The column header row (a data line, so it is part of the checked artifact). -/
def tsvColumns : String := "fixture\tpartition\tm\tqnum\tnum\tden\tqdec15"

/-- The complete TSV artifact. -/
def tsvLines : List String :=
  tsvHeader ++ [tsvColumns] ++ crossCheckRows.map CrossCheckRow.tsvLine

/-- Non-empty, non-comment lines — the part `--check` diffs. -/
def dataLines (s : String) : List String :=
  (s.splitOn "\n").filter (fun l => !l.isEmpty && !l.startsWith "#")

/-- Every row satisfies `-1/2 ≤ Q ≤ 1` exactly (`2·num` against `±den`). -/
def rangeOk (r : CrossCheckRow) : Bool :=
  let p := r.reducedQ
  decide (-(p.2 : Int) ≤ 2 * p.1 ∧ 2 * p.1 ≤ 2 * (p.2 : Int))

/-- The §5 fixture-4 acceptance property at the exact layer:
`Qnum(after) ≥ Qnum(before)`. -/
def localMoveOk : Bool :=
  match (crossCheckRows.filter (fun r => r.fixture == "4a")).head?,
        (crossCheckRows.filter (fun r => r.fixture == "4b")).head? with
  | some b, some a => decide (b.qnum ≤ a.qnum)
  | _, _ => false

/-- Human-readable table plus the fixture-level checks. -/
def printHuman : IO Unit := do
  IO.println "AVI-1301 — AVI-618 §6 modularity cross-check (Lean arm)"
  IO.println "Lean side is exact: Q = (2m)^2·Q / (2m)^2, evaluated by kernel reduction."
  IO.println "Haskell arm: cabal test graphos-test (Graphos.Domain.ModularityCrossCheckSpec)"
  IO.println "Tolerance: eps = 2^-24 (Double rounding only; rational fixtures are exact)."
  IO.println ""
  IO.println "  fixture  partition           m   qnum    Q (exact)   Q (decimal)"
  for r in crossCheckRows do
    IO.println s!"  {r.fixture}\t{r.partition}\t{r.m}\t{r.qnum}\t{r.qFraction}\t{r.qDecimal}"
  IO.println ""
  IO.println "checks:"
  IO.println s!"  fixture 5 range (-1/2 <= Q <= 1) on all rows: {if crossCheckRows.all rangeOk then "ok" else "VIOLATED"}"
  IO.println s!"  fixture 4 local move non-decreasing (exact): {if localMoveOk then "ok" else "VIOLATED"}"
  IO.println ""
  IO.println "verdict: the Lean definition reduces to the §5 exact values."

/-- `--check`: regenerate and diff the checked-in table. -/
def runCheck (path : String) : IO UInt32 := do
  let expected := dataLines (String.intercalate "\n" tsvLines)
  let actual := dataLines (← IO.FS.readFile path)
  if actual == expected then
    IO.println s!"cross-check table is current: {path} ({expected.length} data lines)"
    return 0
  IO.println s!"cross-check table DRIFTED from the Lean computation: {path}"
  let mut i := 0
  for p in expected.zip actual do
    if p.1 != p.2 then
      IO.println s!"  line {i + 1}:"
      IO.println s!"    expected: {p.1}"
      IO.println s!"    actual:   {p.2}"
    i := i + 1
  if expected.length != actual.length then
    IO.println s!"  line count: expected {expected.length}, actual {actual.length}"
  IO.println "  regenerate with: lake exe modularity-crosscheck --tsv > crosscheck/q-lean.tsv"
  return 1

end GraphosFormalization

/-- `lake exe modularity-crosscheck` entry point. -/
def main (args : List String) : IO UInt32 := do
  match args with
  | ["--tsv"] | ["tsv"] =>
      for line in GraphosFormalization.tsvLines do
        IO.println line
      return 0
  | ["--check", path] | ["check", path] =>
      GraphosFormalization.runCheck path
  | [] =>
      GraphosFormalization.printHuman
      return 0
  | _ =>
      IO.println "usage: modularity-crosscheck [--tsv | --check <tsv-path>]"
      return 2
