    , base64-bytestring     >= 1.0
    , cryptohash-sha256     >= 0.11

-- ───────────────────────────────────────────────
-- Executable
-- ───────────────────────────────────────────────
executable graphos
  import:         shared
  main-is:        Main.hs
  hs-source-dirs: app
  ghc-options:    -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      base
    , graphos
    , optparse-applicative >= 0.17
    , text
    , containers
    , aeson
    , bytestring
    , directory
    , yaml
    , directory
    , yaml

-- ───────────────────────────────────────────────
-- Test Suite
-- ───────────────────────────────────────────────
