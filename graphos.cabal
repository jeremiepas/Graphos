    , mtl                  >= 2.2
    , network              >= 3.1
    , optparse-applicative >= 0.17
    , process              >= 1.6
    , sorted-list          >= 0.2
    , stm                  >= 2.5
    , text                 >= 1.2
    , time                 >= 1.11
    , transformers         >= 0.5
    , tree-sitter          >= 0.9
    , tree-sitter-typescript >= 0.5
    , tree-sitter-python   >= 0.9
    , tree-sitter-rust      >= 0.1
