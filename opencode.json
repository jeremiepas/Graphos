{
  "$schema": "https://opencode.ai/config.json",
  "model": "executor/qwen3.8-executor",
  "small_model": "executor/qwen3.8-executor",
  "compaction": { "auto": true, "tail_turns": 5 },
  "experimental": { "mcp_timeout": 60000, "primary_tools": ["edit", "bash"] },
  "provider": {
    "llama": {
      "name": "Local llama.cpp server (Qwen 3.6)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://100.120.26.64:8080/v1",
        "timeout": 600000,
        "chunkTimeout": 600000
      },
      "models": {
        "qwen3.6-35b-a3b": {
          "name": "qwen3.6-35b-a3b",
          "limit": {
            "context": 131172,
            "output": 8192
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "tool_call": true,
          "reasoning": true
        },
        "qwen3.6-35b-a3b-nothink": {
          "name": "qwen3.6-35b-a3b-nothink",
          "limit": {
            "context": 131172,
            "output": 8192
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "tool_call": true,
          "reasoning": false
        }
      }
    },
    "gemma": {
      "name": "Local llama.cpp server (Gemma 4 MoE)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://montech:8081/v1",
        "timeout": 600000,
        "chunkTimeout": 600000
      },
      "models": {
        "gemma4-moe": {
          "name": "gemma4-moe",
          "limit": {
            "context": 65536,
            "output": 4096
          },
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "tool_call": true,
          "reasoning": true
        },
        "gemma4-moe-nothink": {
          "name": "gemma4-moe-nothink",
          "limit": {
            "context": 200000,
            "output": 4096
          },
          "modalities": {
            "input": ["text"],
            "output": ["text"]
          },
          "tool_call": true,
          "reasoning": false
        }
      }
    },
    "orchestrator": {
      "name": "Qwen3.8-27B Orchestrator (CPU, 300k ctx)",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://montech:8082/v1",
        "timeout": 600000,
        "chunkTimeout": 600000
      },
      "models": {
        "qwen3.8-orchestrator": {
          "name": "Qwen3.8-27B Orchestrator (CPU, 300k ctx)",
          "limit": {
            "context": 300000,
            "output": 8192
          },
          "tool_call": true,
          "reasoning": true,
          "variants": { "thinking": {} }
